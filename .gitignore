# Public branch excludes upstream examples and private experiment wrappers.
/docker/
/examples/
/recipe/
/scripts/
/tests/
/tools_server/
/eval_qwen3.sh
/train_siop_auto.sh
/.readthedocs.yaml

# Keep only the compact SIOP public docs in this branch.
/docs/*
!/docs/
!/docs/SIOP_USAGE.md

# Exclude non-SIOP experimental modules from the public snapshot.
/verl/experimental/*
!/verl/experimental/
!/verl/experimental/__init__.py
!/verl/experimental/agent_loop/

# Generated trainer configs are reproducible and contain local defaults.
/verl/trainer/config/_generated_*.yaml

# Paper working directory is separate; keep paper.md only.
/paper/
